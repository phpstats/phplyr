{
    "package": "phplyr",
    "title": "phplyr",
    "tagline": "A PHP port of the Tidyverse's dplyr and tidyr.",
    "summary": "Filter, transform, join, and reshape tables with dplyr- and tidyr-style functions. Use PHP 8.5 pipes or method chains on PHP 8.3 and later. Pipelines run on phibble's in-memory DataFrame, on databases through SQL, and on Polars.",
    "install": [
        "composer require phpstats/phplyr"
    ],
    "php": [
        "8.3",
        "8.4",
        "8.5"
    ],
    "requires": [
        "phibble (installed by Composer)",
        "PDO extension",
        "mbstring extension"
    ],
    "optional": [
        {
            "name": "phit extension",
            "for": "statistical models and native descriptive statistics"
        },
        {
            "name": "phpolars extension",
            "for": "the Polars backend"
        },
        {
            "name": "intl extension",
            "for": "janitor's transliteration of names"
        },
        {
            "name": "PDO driver for SQLite, PostgreSQL, or MySQL",
            "for": "database tables"
        }
    ],
    "build": [],
    "platforms": [
        "Linux",
        "macOS"
    ],
    "installation": "getting-started#installation",
    "quickstart": "getting-started",
    "repository": "https://github.com/phpstats/phplyr",
    "example": {
        "setup": [
            "composer require phpstats/phplyr"
        ],
        "chain": "use Phibble\\DataFrame;\nuse function Phplyr\\{phplyr, desc, n, mean, sd};\n\n$data = 'https://raw.githubusercontent.com/phpstats'\n    . '/datasets/main/csv';\n$penguins = DataFrame::fromCsv(\"$data/penguins.csv\");\n\necho phplyr($penguins)\n    ->filter(fn ($r) => $r->body_mass_g !== null)\n    ->groupBy('species')\n    ->summarize(\n        penguins: n(),\n        avg_mass_g: mean('body_mass_g'),\n        sd_mass_g: sd('body_mass_g'),\n    )\n    ->arrange(desc('avg_mass_g'));",
        "pipe": "use Phibble\\DataFrame;\nuse function Phplyr\\{filter, group_by, summarize};\nuse function Phplyr\\{arrange, desc, n, mean, sd};\n\n$data = 'https://raw.githubusercontent.com/phpstats'\n    . '/datasets/main/csv';\n$penguins = DataFrame::fromCsv(\"$data/penguins.csv\");\n\necho $penguins |>\n    filter(fn ($r) => $r->body_mass_g !== null) |>\n    group_by('species') |>\n    summarize(\n        penguins: n(),\n        avg_mass_g: mean('body_mass_g'),\n        sd_mass_g: sd('body_mass_g'),\n    ) |>\n    arrange(desc('avg_mass_g'));",
        "output": "# A tibble: 3 × 4\n  species   penguins avg_mass_g sd_mass_g\n  <chr>        <int>      <dbl>     <dbl>\n1 Gentoo         123      5076.      504.\n2 Chinstrap       68      3733.      384.\n3 Adelie         151      3701.      459."
    },
