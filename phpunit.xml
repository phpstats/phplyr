<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="phplyr">
            <directory suffix="Test.php">tests</directory>
            <exclude>tests/Pipe</exclude>
        </testsuite>
        <!-- Tests written with the |> operator, which only parse on PHP 8.5. -->
        <testsuite name="pipe">
            <directory suffix="Test.php" phpVersion="8.5.0" phpVersionOperator=">=">tests/Pipe</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
