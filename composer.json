{
    "name": "phpstats/phplyr",
    "description": "A dplyr-style grammar of data manipulation for PHP 8.3+, with method chains or PHP 8.5 pipes",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "phpstats/phibble": "^0.3",
        "symfony/polyfill-php84": "^1.31"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "ext-phit": "Native descriptives (Phit\\stat_*) and model fitting (Phit\\fit_*), needed for lm(), glm(), lmer(), and glmer()"
    },
    "autoload": {
        "psr-4": {
            "Phplyr\\": "src/"
        },
        "files": [
            "src/functions/verbs.php",
            "src/functions/chain.php",
            "src/functions/vectors.php",
            "src/functions/select.php",
            "src/functions/groups.php",
            "src/functions/joins.php",
            "src/functions/tidyr.php",
            "src/functions/lists.php",
            "src/functions/rows.php",
            "src/functions/scalar.php",
            "src/functions/strings.php",
            "src/functions/dates.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Phplyr\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "phibble",
            "type": "vcs",
            "url": "https://github.com/phpstats/phibble"
        }
    ]
}
