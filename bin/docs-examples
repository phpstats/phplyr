#!/usr/bin/env php
<?php

/*
 * Run every docs/examples/*.php and write docs/examples/_<name>.md with the
 * example's code and its actual output, for Quarto to include. Examples run
 * with docs/data as the working directory, after a hidden prelude that
 * imports Phibble\DataFrame, Phibble\tbl and every Phplyr function except those
 * that would shadow a PHP built-in other than count, min and max (examples
 * import round(), abs() and the like themselves).
 *
 * A <name>.chain.php beside an example is its method-chain version. Both
 * must print the same output, and the page shows them in tabs.
 *
 * R examples (.R files in docs/examples and its subdirectories) run with Rscript the same way and write
 * _<name>-r.md, for side-by-side comparisons. Examples in a subdirectory are
 * named <dir>-<file>.
 *
 * Usage: bin/docs-examples [name ...]   (PHP and NO_EXT env vars as in bin/test)
 */

declare(strict_types=1);

$root = dirname(__DIR__);
require $root.'/vendor/autoload.php';

$functions = array_values(array_filter(
    get_defined_functions()['user'],
    fn (string $f) => str_starts_with($f, 'phplyr\\'),
));
$names = array_map(fn (string $f) => (new ReflectionFunction($f))->getShortName(), $functions);
$names = array_values(array_filter($names, fn (string $n) => ! function_exists('\\'.$n) || in_array($n, ['count', 'min', 'max'], true)));
sort($names);
$preludeFor = function (string $code) use ($names): string {
    // Leave out names the example imports itself.
    preg_match_all('/use function Phplyr\\\\\{([^}]*)\}/', $code, $m);
    $own = array_map('trim', explode(',', implode(',', $m[1])));

    return "use Phibble\\DataFrame;\nuse Phplyr\\Stats;\nuse function Phibble\\tbl;\nuse function Phplyr\\{".implode(', ', array_diff($names, $own))."};\n";
};

$php = getenv('PHP') ?: PHP_BINARY;
$ext = $root.'/.ext/libphit.dylib';
$args = is_file($ext) && getenv('NO_EXT') === false ? ['-d', 'extension='.$ext] : [];

$only = array_slice($argv, 1);
$failed = 0;
$nameOf = fn (string $file, string $ext) => (dirname($file) === $root.'/docs/examples' ? '' : basename(dirname($file)).'-').basename($file, $ext);
$outDir = fn (string $file) => dirname($file);
foreach ([...glob($root.'/docs/examples/*.R'), ...glob($root.'/docs/examples/*/*.R')] as $file) {
    $name = $nameOf($file, '.R');
    if ($only !== [] && ! in_array($name, $only, true)) {
        continue;
    }
    $proc = proc_open(['Rscript', $file], [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $root.'/docs/data');
    $out = stream_get_contents($pipes[1]);
    $err = stream_get_contents($pipes[2]);
    if (proc_close($proc) !== 0) {
        fwrite(STDERR, "{$name} (R): failed\n{$out}{$err}\n");
        $failed++;

        continue;
    }
    $code = trim(file_get_contents($file));
    file_put_contents($outDir($file)."/_".basename($file, '.R').'-r.md', "```r\n{$code}\n```\n\n```{.text .output}\n".rtrim($out)."\n```\n");
    echo "{$name} (R): ok\n";
}
// Run one PHP example; return its code and output, or null if it failed.
$run = function (string $file, string $name) use ($root, $php, $args, $preludeFor): ?array {
    $code = trim((string) preg_replace('/^<\?php\s*(declare\(strict_types=1\);\s*)?/', '', file_get_contents($file)));
    $script = tempnam(sys_get_temp_dir(), 'phplyr-doc').'.php';
    file_put_contents($script, "<?php\n\ndeclare(strict_types=1);\n\nrequire ".var_export($root.'/vendor/autoload.php', true).";\n\n".$preludeFor($code)."\n".$code."\n");
    $cmd = array_merge([$php], $args, [$script]);
    $proc = proc_open($cmd, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $root.'/docs/data');
    $out = stream_get_contents($pipes[1]);
    $err = stream_get_contents($pipes[2]);
    $status = proc_close($proc);
    unlink($script);
    if ($status !== 0) {
        fwrite(STDERR, "{$name}: failed\n{$out}{$err}\n");

        return null;
    }

    return [$code, $out];
};
// An example <name>.php uses |>. Its method-chain version, <name>.chain.php,
// must print the same output; the page shows both in tabs and the output once.
foreach ([...glob($root.'/docs/examples/*.php'), ...glob($root.'/docs/examples/*/*.php')] as $file) {
    if (str_ends_with($file, '.chain.php')) {
        continue;
    }
    $name = $nameOf($file, '.php');
    if ($only !== [] && ! in_array($name, $only, true)) {
        continue;
    }
    $pipe = $run($file, $name);
    $chainFile = substr($file, 0, -4).'.chain.php';
    $chain = is_file($chainFile) ? $run($chainFile, "{$name} (chain)") : null;
    if ($pipe === null || (is_file($chainFile) && $chain === null)) {
        $failed++;

        continue;
    }
    [$code, $out] = $pipe;
    if ($chain === null) {
        $md = "```php\n{$code}\n```\n\n";
    } else {
        if ($chain[1] !== $out) {
            fwrite(STDERR, "{$name}: the method chain prints different output from the pipe version\n");
            $failed++;

            continue;
        }
        $md = "::: {.panel-tabset group=\"syntax\"}\n\n## Method chain (PHP 8.3+)\n\n```php\n{$chain[0]}\n```\n\n## Pipe (PHP 8.5)\n\n```php\n{$code}\n```\n\n:::\n\n";
    }
    if (trim($out) !== '') {
        $md .= "```{.text .output}\n".rtrim($out)."\n```\n";
    }
    file_put_contents($outDir($file).'/_'.basename($file, '.php').'.md', $md);
    echo "{$name}: ok\n";
}
exit($failed > 0 ? 1 : 0);
