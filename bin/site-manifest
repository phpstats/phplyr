#!/usr/bin/env php
<?php

/*
 * Write site/site.json, the manifest the PHPstats site reads for
 * phplyr.phpstats.org. The example comes from docs/examples/first-pipeline
 * (both versions and the output bin/docs-examples recorded), and the lists of
 * benchmark and verification files come from site/.
 *
 * Usage: bin/site-manifest
 */

declare(strict_types=1);

$root = dirname(__DIR__);
// The example without the opening tag and the require line, as the docs show it.
$code = fn (string $file) => trim((string) preg_replace(
    ['/^<\?php\s*/', '/^require .*autoload\.php\';\n+/m'],
    '',
    file_get_contents($root.'/docs/examples/'.$file),
));
preg_match('/```\{\.text \.output\}\n(.*?)\n```/s', file_get_contents($root.'/docs/examples/_first-pipeline.md'), $m);

// The docs sidebar, in docs/_quarto.yml's order, with its sections.
$nav = [];
foreach ([
    'Getting started' => [
        'Overview' => 'index.qmd',
        'Getting started' => 'getting-started.qmd',
        'Compatibility and limitations' => 'compatibility.qmd',
    ],
    'Guides' => [
        'Coming from dplyr' => 'coming-from-dplyr.qmd',
        'Translate an R script' => 'port-r-script.qmd',
        'Performance' => 'performance.qmd',
    ],
    'Functions and methods' => [
        'Functions and methods' => 'reference/index.qmd',
        'Pipes and method chains' => 'reference/chains.qmd',
        'Single-table functions' => 'reference/single-table.qmd',
        'Joins, binding, and set operations' => 'reference/two-table.qmd',
        'Grouping' => 'reference/grouping.qmd',
        'Vector helpers' => 'reference/vectors.qmd',
        'Strings and dates' => 'reference/strings-dates.qmd',
        'Selecting columns' => 'reference/tidyselect.qmd',
        'Reshaping with tidyr' => 'reference/tidyr.qmd',
        'Cleaning with janitor' => 'reference/janitor.qmd',
        'Models' => 'reference/models.qmd',
        'Databases and expressions' => 'reference/databases.qmd',
    ],
    'Examples' => [
        'Filter rows and add columns' => 'examples/filter-and-mutate.qmd',
        'Summarize groups' => 'examples/group-and-summarize.qmd',
        'Join two tables' => 'examples/join.qmd',
        'Pivot between wide and long' => 'examples/pivot.qmd',
        'Gallery' => 'gallery.qmd',
    ],
    'Contributing' => [
        'Development' => 'development.qmd',
    ],
] as $section => $pages) {
    foreach ($pages as $title => $path) {
        $nav[] = ['title' => $title, 'path' => $path, 'section' => $section];
    }
}
foreach ($nav as $entry) {
    $html = $root.'/docs/'.substr($entry['path'], 0, -4).'.html';
    if (! is_file($html)) {
        fwrite(STDERR, "missing rendered page for {$entry['path']}; run bin/render-docs\n");
        exit(1);
    }
}

$files = fn (string $dir) => array_map(fn ($f) => 'site/'.$dir.'/'.basename($f), glob($root.'/site/'.$dir.'/*.json'));
$ordered = function (string $dir, array $order) use ($files): array {
    $paths = $files($dir);
    usort($paths, fn ($a, $b) => array_search(basename($a, '.json'), $order, true) <=> array_search(basename($b, '.json'), $order, true));

    return $paths;
};
$verifications = $ordered('verifications', ['dplyr', 'tidyr', 'additions', 'lubridate-stringr', 'janitor', 'descriptives', 'models', 'polars', 'sqlite']);
$benchmarks = $ordered('benchmarks', ['backends', 'workloads', 'models']);

// The curated examples, in nav order. Each path is a page in the docs'
// Examples section.
$examples = [
    ['path' => 'examples/filter-and-mutate', 'title' => 'Filter rows and add columns', 'description' => 'Keep the penguins with a recorded body mass, and add the mass in kilograms and a size label.'],
    ['path' => 'examples/group-and-summarize', 'title' => 'Summarize groups', 'description' => 'Count the penguins and find the mean and largest body mass for each species, with some masses missing.'],
    ['path' => 'examples/join', 'title' => 'Join two tables', 'description' => 'Add airport names and altitudes to hourly weather readings from the nycflights13 tables.'],
    ['path' => 'examples/pivot', 'title' => 'Pivot between wide and long', 'description' => 'Count penguins per species with one column per study year, then stack the years into rows.'],
];
foreach ($examples as $example) {
    if (! \in_array($example['path'].'.qmd', array_column($nav, 'path'), true)) {
        fwrite(STDERR, "{$example['path']} is not in the docs nav\n");
        exit(1);
    }
}

$manifest = [
    'package' => 'phplyr',
    'title' => 'phplyr',
    'tagline' => 'dplyr- and tidyr-style data manipulation for PHP.',
    'summary' => 'Filter, transform, join, and reshape tables with dplyr- and tidyr-style functions. Use PHP 8.5 pipes or method chains on PHP 8.3 and later. Pipelines run on phibble\'s in-memory DataFrame, on databases through SQL, and on Polars.',
    'install' => ['composer require phpstats/phplyr'],
    'php' => ['8.3', '8.4', '8.5'],
    'requires' => ['phibble (installed by Composer)', 'PDO extension', 'mbstring extension'],
    'optional' => [
        ['name' => 'phit extension', 'for' => 'statistical models and native descriptive statistics'],
        ['name' => 'phpolars extension', 'for' => 'the Polars backend'],
        ['name' => 'intl extension', 'for' => 'janitor\'s transliteration of names'],
        ['name' => 'PDO driver for SQLite, PostgreSQL, or MySQL', 'for' => 'database tables'],
    ],
    'build' => [],
    'platforms' => ['Linux', 'macOS'],
    'installation' => 'getting-started#installation',
    'quickstart' => 'getting-started',
    'repository' => 'https://github.com/phpstats/phplyr',
    'example' => [
        'setup' => [
            'composer require phpstats/phplyr',
        ],
        'chain' => $code('first-pipeline.chain.php'),
        'pipe' => $code('first-pipeline.php'),
        'output' => $m[1] ?? null,
    ],
    'docs' => ['root' => 'docs', 'format' => 'quarto', 'nav' => $nav],
    'benchmarks' => $benchmarks,
    'verifications' => $verifications,
    'evidence_gaps' => [
        'benchmarks' => 'Memory is measured for the models benchmark only; the workloads and backend pipelines record elapsed time.',
        'verification' => 'glmer() is not compared with lme4, phit-polyfill is not compared with R, and PostgreSQL and MySQL tables are not checked.',
    ],
    'examples' => $examples,
];
file_put_contents($root.'/site/site.json', json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n");
echo "site/site.json written\n";
