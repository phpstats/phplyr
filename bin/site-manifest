#!/usr/bin/env php
<?php

/*
 * Write site/site.json, the manifest the phpstats site reads for
 * phplyr.phpstats.org. The example comes from docs/examples/first-pipeline
 * (both versions and the output bin/docs-examples recorded), and the lists of
 * benchmark and verification files come from site/.
 *
 * Usage: bin/site-manifest
 */

declare(strict_types=1);

$root = dirname(__DIR__);
// The latest release, which the data URLs point at.
preg_match('/^release: (\S+)$/m', file_get_contents($root.'/docs/_variables.yml'), $r);
$release = $r[1];

// The example without the opening tag and the require line, as the docs show it.
$code = fn (string $file) => trim((string) preg_replace(
    ['/^<\?php\s*/', '/^require .*autoload\.php\';\n+/m'],
    '',
    file_get_contents($root.'/docs/examples/'.$file),
));
preg_match('/```\{\.text \.output\}\n(.*?)\n```/s', file_get_contents($root.'/docs/examples/_first-pipeline.md'), $m);

$nav = [
    ['title' => 'Overview', 'path' => 'index.qmd'],
    ['title' => 'Getting started', 'path' => 'getting-started.qmd'],
    ['title' => 'Coming from dplyr', 'path' => 'coming-from-dplyr.qmd'],
    ['title' => 'Porting an R script', 'path' => 'port-r-script.qmd'],
    ['title' => 'Single-table functions', 'path' => 'reference/single-table.qmd'],
    ['title' => 'Joins, binding, and set operations', 'path' => 'reference/two-table.qmd'],
    ['title' => 'Grouping', 'path' => 'reference/grouping.qmd'],
    ['title' => 'Vector helpers', 'path' => 'reference/vectors.qmd'],
    ['title' => 'Strings and dates', 'path' => 'reference/strings-dates.qmd'],
    ['title' => 'Selecting columns', 'path' => 'reference/tidyselect.qmd'],
    ['title' => 'Reshaping with tidyr', 'path' => 'reference/tidyr.qmd'],
    ['title' => 'Cleaning with janitor', 'path' => 'reference/janitor.qmd'],
    ['title' => 'Models', 'path' => 'reference/models.qmd'],
    ['title' => 'Databases and expressions', 'path' => 'reference/databases.qmd'],
    ['title' => 'Filter rows and add columns', 'path' => 'examples/filter-and-mutate.qmd'],
    ['title' => 'Summarize groups', 'path' => 'examples/group-and-summarize.qmd'],
    ['title' => 'Join two tables', 'path' => 'examples/join.qmd'],
    ['title' => 'Pivot between wide and long', 'path' => 'examples/pivot.qmd'],
    ['title' => 'Gallery', 'path' => 'gallery.qmd'],
    ['title' => 'Compatibility and limitations', 'path' => 'compatibility.qmd'],
    ['title' => 'Performance', 'path' => 'performance.qmd'],
    ['title' => 'Development', 'path' => 'development.qmd'],
];
foreach ($nav as $entry) {
    $html = $root.'/docs/'.substr($entry['path'], 0, -4).'.html';
    if (! is_file($html)) {
        fwrite(STDERR, "missing rendered page for {$entry['path']}; run bin/render-docs\n");
        exit(1);
    }
}

$files = fn (string $dir) => array_map(fn ($f) => 'site/'.$dir.'/'.basename($f), glob($root.'/site/'.$dir.'/*.json'));
$order = ['dplyr', 'tidyr', 'additions', 'lubridate-stringr', 'janitor', 'models', 'polars'];
$verifications = $files('verifications');
usort($verifications, fn ($a, $b) => array_search(basename($a, '.json'), $order, true) <=> array_search(basename($b, '.json'), $order, true));

// The curated examples, in nav order. Each path is a page in the docs'
// Examples section.
$examples = [
    ['path' => 'examples/filter-and-mutate', 'title' => 'Filter rows and add columns', 'description' => 'Keep matching rows and compute new columns, row by row or from whole columns.'],
    ['path' => 'examples/group-and-summarize', 'title' => 'Summarize groups', 'description' => 'Count, total, and average within groups when some values are missing.'],
    ['path' => 'examples/join', 'title' => 'Join two tables', 'description' => 'Combine tables on a shared key, including keys with no match or several.'],
    ['path' => 'examples/pivot', 'title' => 'Pivot between wide and long', 'description' => 'Turn one column per year into one row per year, and back.'],
];
foreach ($examples as $example) {
    if (! \in_array($example['path'].'.qmd', array_column($nav, 'path'), true)) {
        fwrite(STDERR, "{$example['path']} is not in the docs nav\n");
        exit(1);
    }
}

$manifest = [
    'package' => 'phplyr',
    'title' => 'phplyr',
    'tagline' => 'A PHP port of the Tidyverse\'s dplyr and tidyr.',
    'summary' => 'Filter, transform, join, and reshape tables with dplyr- and tidyr-style functions. Use PHP 8.5 pipes or method chains on PHP 8.3 and later. Pipelines run on phibble\'s in-memory DataFrame, on databases through SQL, and on Polars.',
    'install' => ['composer require phpstats/phplyr'],
    'php' => ['8.3', '8.4', '8.5'],
    'requires' => ['phibble (installed by Composer)', 'PDO extension', 'mbstring extension'],
    'optional' => [
        ['name' => 'phit extension', 'for' => 'statistical models and native descriptive statistics'],
        ['name' => 'phpolars extension', 'for' => 'the Polars backend'],
        ['name' => 'intl extension', 'for' => 'janitor\'s transliteration of names'],
        ['name' => 'PDO driver for SQLite, PostgreSQL, or MySQL', 'for' => 'database tables'],
    ],
    'build' => [],
    'platforms' => ['Linux', 'macOS'],
    'installation' => 'getting-started#installation',
    'quickstart' => 'getting-started',
    'repository' => 'https://github.com/phpstats/phplyr',
    'example' => [
        'setup' => [
            'composer require phpstats/phplyr',
            "curl -O https://raw.githubusercontent.com/phpstats/phplyr/{$release}/docs/data/schools.csv",
        ],
        'chain' => $code('first-pipeline.chain.php'),
        'pipe' => $code('first-pipeline.php'),
        'output' => $m[1] ?? null,
    ],
    'docs' => ['root' => 'docs', 'format' => 'quarto', 'nav' => $nav],
    'benchmarks' => $files('benchmarks'),
    'verifications' => $verifications,
    'examples' => $examples,
];
file_put_contents($root.'/site/site.json', json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n");
echo "site/site.json written\n";
